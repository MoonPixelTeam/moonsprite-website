# Node 24. Production serves dist/ and /api on the same origin.
VITE_API_BASE_URL=/api
PUBLIC_ORIGIN=http://localhost:5173
HOST=127.0.0.1
PORT=3001
DATA_DIR=server/data
# Set only when a trusted reverse proxy overwrites X-Real-IP and the API is private.
TRUST_PROXY=0
# Production requires NODE_ENV=production, HTTPS PUBLIC_ORIGIN, SMTP_URL, MAIL_FROM.
# SMTP_URL=smtps://username:URL_ENCODED_PASSWORD@smtp.example.com:465
# MAIL_FROM=MoonSprite <noreply@example.com>
# Without SMTP in development, messages are written to server/data/mail/.

# Obtain these from https://z-pay.cn/ merchant settings; never use VITE_ for secrets.
ZPAY_PID=
ZPAY_KEY=
ZPAY_CID=
# ADMIN_PASSWORD is used only by the create-admin CLI; no default password.
