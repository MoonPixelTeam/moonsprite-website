{
  "name": "moonsprite-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:frontend": "vite",
    "server": "node --env-file-if-exists=.env server/index.mjs",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "manage": "node --env-file-if-exists=.env server/manage.mjs",
    "seed:catalogue": "node scripts/seed-catalogue.mjs",
    "test:backend": "node --test scripts/backend.test.mjs",
    "test:browser": "node scripts/backend-smoke.mjs",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "check:classes": "node scripts/check-classes.mjs",
    "check:icons": "node scripts/check-icons.mjs",
    "check": "tsc --noEmit && node scripts/check-classes.mjs && node scripts/check-icons.mjs",
    "test": "node scripts/test.mjs",
    "capture:product": "node scripts/capture-product.mjs"
  },
  "engines": { "node": ">=24.0.0" },
  "dependencies": {
    "nodemailer": "^10.0.12",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "jsdom": "29.1.1",
    "playwright": "1.62.0",
    "typescript": "7.0.2",
    "vite": "8.1.5"
  }
}
